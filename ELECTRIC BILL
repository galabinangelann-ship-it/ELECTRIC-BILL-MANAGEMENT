void loadBills(struct Customer bills[], int *count) {
    FILE *fp = fopen("bills.txt", "r");
    if (!fp) {
        printf("No existing data found. Starting fresh...\n");
        return;
    }

    while (!feof(fp)) {
        struct Customer c;
        if (fscanf(fp, "%d|%49[^|]|%49[^|]|%29[^|]|%29[^|]|%f|%f|%f\n",
                   &c.meterNumber, c.name,
                   c.address.street, c.address.city, c.address.province,
                   &c.kwhUsed, &c.rate, &c.totalBill) == 8)
        {
            bills[*count] = c;
            (*count)++;
        }
    }

    fclose(fp);
}

void saveBills(struct Customer bills[], int count) {
    FILE *fp = fopen("bills.txt", "w");

    for (int i = 0; i < count; i++) {
        fprintf(fp, "%d|%s|%s|%s|%s|%.2f|%.2f|%.2f\n",
                bills[i].meterNumber, bills[i].name,
                bills[i].address.street, bills[i].address.city, bills[i].address.province,
                bills[i].kwhUsed, bills[i].rate, bills[i].totalBill);
    }

    fclose(fp);
}


